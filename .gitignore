# ─────────────────────────────────────────────────────────────────
# .gitignore — Competitive Intelligence Agent
# ─────────────────────────────────────────────────────────────────

# Environment secrets — NEVER commit these
.env
.env.local
.env.production
.env*.local

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS generated files
.DS_Store
Thumbs.db

# Editor directories
.vscode/settings.json
.idea/

# Build output (if added later)
dist/
build/

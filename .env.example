# ─────────────────────────────────────────────────────────────────
# Competitive Intelligence Agent — Environment Variables
# ─────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your real values.
# NEVER commit .env to source control.
# ─────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────────
PORT=3000

# ── Supabase (server-side / service-role) ─────────────────────────
# These are used by the backend only — never sent to the browser.
# Get them from: Supabase Dashboard → Settings → API
SUPABASE_URL=url_to_your_supabase_instance
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ── Hindsight Memory (server-side only) ───────────────────────────
# NEVER prefix with VITE_PUBLIC_ or NEXT_PUBLIC_ — must stay server-side.
# Get it from: https://app.hindsight.vectorize.io → API Keys
HINDSIGHT_API_KEY=
HINDSIGHT_BANK_ID=competitive-intelligence
HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io

# ── Google Gemini (server-side only) ─────────────────────────────
GEMINI_API_KEY=
